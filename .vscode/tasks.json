{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build C program",
            "type": "shell",
            "command": "/bin/sh",
            "args": [
                "-c",
                "mkdir -p build && /usr/bin/clang -std=c17 -Wall -Wextra -g PH_Pascal_Triangle_2025/pascal_pyramid.c -o build/pascal_pyramid"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Run C program",
            "type": "shell",
            "command": "./build/pascal_pyramid",
            "dependsOn": "Build C program",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always"
            }
        }
    ]
}